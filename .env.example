# ==============================================================================
# NER LANDSLIDEGUARD - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for Next.js and `.env` for FastAPI backend.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Next.js)
# ------------------------------------------------------------------------------
# Base URL for the Python FastAPI Prediction & Risk Engine
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Synthetic Demo Mode Toggle (true: works without external hardware/API keys; false: strictly calls live services)
NEXT_PUBLIC_DEMO_MODE=true

# Default Language (en: English, hi: Hindi, as: Assamese)
NEXT_PUBLIC_DEFAULT_LANG=en

# EOC Center Operations Node Identifier
NEXT_PUBLIC_EOC_NODE=NER-EAST-EOC-GUWAHATI-01

# Public Leaflet / OpenStreetMap Tile Server
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (FastAPI)
# ------------------------------------------------------------------------------
# Server Network Binding
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated or '*' for local development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to trained Random Forest Model Artifact (.joblib)
MODEL_PATH=app/ml/model.joblib

# Debug / Reload Mode
DEBUG=True

# ------------------------------------------------------------------------------
# 3. FUTURE REAL-DATA INTEGRATIONS (Optional / Production)
# ------------------------------------------------------------------------------
# India Meteorological Department (IMD) AWS API Key
IMD_API_KEY=

# Central Water Commission (CWC) Hydrological API
CWC_API_ENDPOINT=

# LoRaWAN / MQTT IoT Gateway Broker (e.g., The Things Network or EMQX)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_SENSORS=ner/geotech/sensors/#

# Common Alerting Protocol (CAP-IPAWS) National Disaster Management Authority (NDMA) Dispatch Token
CAP_GATEWAY_TOKEN=
